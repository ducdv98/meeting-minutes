{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Minutes",
  "version": "0.1.0",
  "identifier": "app.meeting-minutes.tech",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Meeting Minutes/**"]
      }
    },
    "windows": [
      {
        "title": "Meeting Minutes",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "customLanguageFiles": { "English": "./windows/English.nsh" },
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ducdv98/meeting-minutes/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_TICKET_04_PUBLIC_KEY",
      "windows": { "installMode": "passive" }
    }
  }
}
